# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (use rzp_live_* in production; never commit real secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (API user email/password from Shiprocket → Settings → API)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact pickup nickname from Shiprocket → Settings → Pickup Address
SHIPROCKET_PICKUP_LOCATION=
# Shiprocket dashboard → Webhooks: Auth Token Type = x-api-key (same value here)
SHIPPING_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=orders@jaijinendra.com

# Admin (required — no default password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Customer phone OTP — set to skip SMS and accept this code for every number (dev/staging).
# Leave unset in production once real SMS is wired.
AUTH_FIXED_OTP=123456

# Site
NEXT_PUBLIC_SITE_URL=https://www.jaijinendrasweets.com
NEXT_PUBLIC_SITE_NAME=Jai Jinendra
